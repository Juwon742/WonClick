<Window x:Class="WonClick.AutoParameter.UI.AutoParameterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WonClick - Auto Parameter"
        Width="760"
        Height="520"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- =====================================================
             TITLE
             ===================================================== -->

        <StackPanel Grid.Row="0">

            <TextBlock Text="Auto Parameter"
                       FontSize="22"
                       FontWeight="SemiBold"/>

            <TextBlock Margin="0,6,0,0"
                       Foreground="#666666"
                       Text="새로 생성되는 객체의 Instance Parameter에 여러 값을 동시에 자동 입력합니다."/>

            <TextBlock x:Name="CatalogInfoTextBlock"
                       Margin="0,5,0,0"
                       Foreground="#888888"
                       FontSize="11"
                       Text="Parameter catalog 준비 중..."/>

        </StackPanel>


        <!-- =====================================================
             RULE TABLE
             ===================================================== -->

        <DataGrid x:Name="RuleDataGrid"
                  Grid.Row="2"
                  ItemsSource="{Binding RuleRows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">

            <DataGrid.Columns>

                <!-- USE -->

                <DataGridTemplateColumn Header="Use"
                                        Width="60">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <CheckBox IsChecked="{Binding Enabled,
                                                       Mode=TwoWay,
                                                       UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>


                <!-- PARAMETER -->

                <DataGridTemplateColumn Header="Instance Parameter"
                                        Width="2*">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <ComboBox ItemsSource="{Binding DataContext.ParameterItems,
                                           RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding SelectedParameter,
                                           Mode=TwoWay,
                                           UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Name"
                                      Margin="4"
                                      Height="28"
                                      IsTextSearchEnabled="True"
                                      VerticalContentAlignment="Center"/>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>


                <!-- VALUE -->

                <DataGridTemplateColumn Header="Value"
                                        Width="2*">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <TextBox Text="{Binding Value,
                                      Mode=TwoWay,
                                      UpdateSourceTrigger=PropertyChanged}"
                                     Margin="4"
                                     Height="28"
                                     VerticalContentAlignment="Center"/>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>


                <!-- REMOVE -->

                <DataGridTemplateColumn Header=""
                                        Width="75">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <Button Content="Remove"
                                    Margin="4"
                                    Height="28"
                                    Click="RemoveRuleButton_Click"/>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>


        <!-- =====================================================
             RULE / EXPORT / IMPORT
             ===================================================== -->

        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Button x:Name="AddRuleButton"
                    Grid.Column="0"
                    Width="110"
                    Height="32"
                    Content="+ Add Rule"
                    Click="AddRuleButton_Click"/>


            <Button x:Name="ExportSettingsButton"
                    Grid.Column="2"
                    Width="130"
                    Height="32"
                    Content="Export Settings"
                    Click="ExportSettingsButton_Click"/>


            <Button x:Name="ImportSettingsButton"
                    Grid.Column="4"
                    Width="130"
                    Height="32"
                    Content="Import Settings"
                    Click="ImportSettingsButton_Click"/>

        </Grid>


        <!-- =====================================================
             STATUS
             ===================================================== -->

        <Border Grid.Row="6"
                Padding="12"
                BorderThickness="1"
                BorderBrush="#D0D0D0"
                CornerRadius="4">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0"
                           Text="Status"
                           FontWeight="SemiBold"/>


                <TextBlock x:Name="StatusTextBlock"
                           Grid.Column="2"
                           Text="OFF"
                           FontWeight="Bold"/>

            </Grid>

        </Border>


        <!-- =====================================================
             BOTTOM
             ===================================================== -->

        <Grid Grid.Row="8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Button x:Name="ApplyButton"
                    Grid.Column="0"
                    Height="40"
                    Content="Apply / Update"
                    Click="ApplyButton_Click"/>


            <Button x:Name="DisableButton"
                    Grid.Column="2"
                    Height="40"
                    Content="OFF"
                    Click="DisableButton_Click"/>


            <Button x:Name="CloseButton"
                    Grid.Column="4"
                    Height="40"
                    Content="Close"
                    Click="CloseButton_Click"/>

        </Grid>


        <!-- =====================================================
             LOADING OVERLAY
             ===================================================== -->

        <Border x:Name="LoadingOverlay"
                Grid.Row="0"
                Grid.RowSpan="9"
                Background="#EEFFFFFF"
                Panel.ZIndex="100">

            <Grid>

                <StackPanel Width="300"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="Parameter Loading..."
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Margin="0,8,0,16"
                               Text="사용 가능한 Instance Parameter를 준비하고 있습니다."
                               Foreground="#666666"
                               HorizontalAlignment="Center"/>

                    <ProgressBar Height="6"
                                 IsIndeterminate="True"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>
</Window>