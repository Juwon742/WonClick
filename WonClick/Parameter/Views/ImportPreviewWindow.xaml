<Window x:Class="WonClick.Parameter.Views.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WonClick - Import Preview"
        Width="1240"
        Height="780"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="#F4F5F7">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#D9DDE3"
                BorderThickness="0,0,0,1"
                Padding="22,18">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock x:Name="WindowTitleTextBlock"
                               Text="Import Preview"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#202124" />

                    <TextBlock x:Name="WindowSubtitleTextBlock"
                               Margin="0,5,0,0"
                               Text="Excel과 현재 Revit 값을 비교한 변경 항목"
                               FontSize="12"
                               Foreground="#72767D" />

                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <TextBlock Text="Excel File"
                               HorizontalAlignment="Right"
                               FontSize="11"
                               Foreground="#8A8E94" />

                    <TextBlock x:Name="FileNameTextBlock"
                               Margin="20,3,0,0"
                               MaxWidth="420"
                               HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#404348" />

                </StackPanel>
            </Grid>
        </Border>


        <!-- SUMMARY -->

        <Grid Grid.Row="1"
              Margin="18,16,18,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- TOTAL -->

            <Border x:Name="TotalCardBorder"
                    Grid.Column="0"
                    Background="White"
                    BorderBrush="#D8DCE2"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="14,10">

                <StackPanel>

                    <TextBlock Text="전체"
                               FontSize="11"
                               Foreground="#777B81" />

                    <TextBlock x:Name="TotalCountTextBlock"
                               Margin="0,4,0,0"
                               Text="0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#202124" />

                </StackPanel>
            </Border>


            <!-- APPLIED -->

            <Border x:Name="AppliedCardBorder"
                    Grid.Column="2"
                    Background="White"
                    BorderBrush="#D8DCE2"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="14,10">

                <StackPanel>

                    <TextBlock Text="Applied"
                               FontSize="11"
                               Foreground="#777B81" />

                    <TextBlock x:Name="AppliedCountTextBlock"
                               Margin="0,4,0,0"
                               Text="0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#202124" />

                </StackPanel>
            </Border>


            <!-- SKIPPED -->

            <Border x:Name="SkippedCardBorder"
                    Grid.Column="4"
                    Background="White"
                    BorderBrush="#D8DCE2"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="14,10">

                <StackPanel>

                    <TextBlock Text="Skipped"
                               FontSize="11"
                               Foreground="#777B81" />

                    <TextBlock x:Name="SkippedCountTextBlock"
                               Margin="0,4,0,0"
                               Text="0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#202124" />

                </StackPanel>
            </Border>


            <!-- CONFLICT -->

            <Border x:Name="ConflictCardBorder"
                    Grid.Column="6"
                    Background="White"
                    BorderBrush="#D8DCE2"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="14,10">

                <StackPanel>

                    <TextBlock Text="Conflict"
                               FontSize="11"
                               Foreground="#777B81" />

                    <TextBlock x:Name="ConflictCountTextBlock"
                               Margin="0,4,0,0"
                               Text="0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#202124" />

                </StackPanel>
            </Border>


            <!-- FAILED -->

            <Border x:Name="FailedCardBorder"
                    Grid.Column="8"
                    Background="White"
                    BorderBrush="#D8DCE2"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="14,10">

                <StackPanel>

                    <TextBlock Text="Failed"
                               FontSize="11"
                               Foreground="#777B81" />

                    <TextBlock x:Name="FailedCountTextBlock"
                               Margin="0,4,0,0"
                               Text="0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#202124" />

                </StackPanel>
            </Border>


            <!-- READ ONLY -->

            <Border x:Name="ReadOnlyCardBorder"
                    Grid.Column="10"
                    Background="White"
                    BorderBrush="#D8DCE2"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="14,10">

                <StackPanel>

                    <TextBlock Text="Read Only"
                               FontSize="11"
                               Foreground="#777B81" />

                    <TextBlock x:Name="ReadOnlyCountTextBlock"
                               Margin="0,4,0,0"
                               Text="0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#202124" />

                </StackPanel>
            </Border>

        </Grid>


        <!-- RESULT FILTER -->

        <StackPanel x:Name="ResultFilterPanel"
                    Grid.Row="2"
                    Margin="18,0,18,10"
                    Orientation="Horizontal"
                    Visibility="Collapsed">

            <Button x:Name="AllResultFilterButton"
                    Width="76"
                    Height="30"
                    Margin="0,0,6,0"
                    Tag="All"
                    Content="All"
                    Click="ResultFilterButton_Click" />

            <Button x:Name="AppliedResultFilterButton"
                    Width="82"
                    Height="30"
                    Margin="0,0,6,0"
                    Tag="Applied"
                    Content="Applied"
                    Click="ResultFilterButton_Click" />

            <Button x:Name="SkippedResultFilterButton"
                    Width="82"
                    Height="30"
                    Margin="0,0,6,0"
                    Tag="Skipped"
                    Content="Skipped"
                    Click="ResultFilterButton_Click" />

            <Button x:Name="ConflictResultFilterButton"
                    Width="82"
                    Height="30"
                    Margin="0,0,6,0"
                    Tag="Conflict"
                    Content="Conflict"
                    Click="ResultFilterButton_Click" />

            <Button x:Name="FailedResultFilterButton"
                    Width="82"
                    Height="30"
                    Margin="0,0,6,0"
                    Tag="Failed"
                    Content="Failed"
                    Click="ResultFilterButton_Click" />

            <Button x:Name="ReadOnlyResultFilterButton"
                    Width="90"
                    Height="30"
                    Tag="Read Only"
                    Content="Read Only"
                    Click="ResultFilterButton_Click" />

        </StackPanel>


        <!-- CHANGE / RESULT LIST -->

        <Border Grid.Row="3"
                Margin="18,0,18,12"
                Background="White"
                BorderBrush="#D8DCE2"
                BorderThickness="1"
                CornerRadius="3">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="#E0E3E7"
                        BorderThickness="0,0,0,1"
                        Padding="14,10">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ListTitleTextBlock"
                                   Grid.Column="0"
                                   Text="Change List"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#303236" />

                        <TextBlock x:Name="ListCountTextBlock"
                                   Grid.Column="1"
                                   Text="0 Changes"
                                   FontSize="11"
                                   Foreground="#777B81"
                                   VerticalAlignment="Center" />

                    </Grid>
                </Border>

                <DataGrid x:Name="ChangeDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          RowHeaderWidth="0"
                          Background="White"
                          AlternatingRowBackground="#FAFAFB"
                          HorizontalGridLinesBrush="#ECEEF1"
                          VerticalGridLinesBrush="#ECEEF1">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}"
                                            Width="90" />

                        <DataGridTextColumn Header="Category"
                                            Binding="{Binding CategoryName}"
                                            Width="130" />

                        <DataGridTextColumn Header="Family"
                                            Binding="{Binding FamilyName}"
                                            Width="150" />

                        <DataGridTextColumn Header="Type"
                                            Binding="{Binding TypeName}"
                                            Width="150" />

                        <DataGridTextColumn Header="Element ID"
                                            Binding="{Binding ElementIdValue}"
                                            Width="95" />

                        <DataGridTextColumn Header="Parameter"
                                            Binding="{Binding ParameterName}"
                                            Width="160" />

                        <DataGridTextColumn Header="Scope"
                                            Binding="{Binding ScopeName}"
                                            Width="80" />

                        <DataGridTextColumn Header="Revit Value"
                                            Binding="{Binding RevitValue}"
                                            Width="160" />

                        <DataGridTextColumn Header="Excel Value"
                                            Binding="{Binding ExcelValue}"
                                            Width="160" />

                        <DataGridTextColumn Header="Message"
                                            Binding="{Binding Message}"
                                            Width="280" />

                    </DataGrid.Columns>
                </DataGrid>

            </Grid>
        </Border>


        <!-- FOOTER -->

        <Border Grid.Row="4"
                Background="White"
                BorderBrush="#D9DDE3"
                BorderThickness="0,1,0,0"
                Padding="18,12">

            <StackPanel>

                <!-- INLINE APPLY CONFIRMATION -->

                <Border x:Name="ApplyConfirmationPanel"
                        Margin="0,0,0,12"
                        Padding="14"
                        Background="#FFF9E8"
                        BorderBrush="#E3C96E"
                        BorderThickness="1"
                        CornerRadius="3"
                        Visibility="Collapsed">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Excel 변경 내용을 Revit에 적용하시겠습니까?"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#303236" />

                            <TextBlock Margin="0,4,20,0"
                                       Text="적용 후 Revit Parameter 값이 실제로 변경됩니다. Type Parameter는 안전 조건을 만족하는 경우에만 적용됩니다."
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="#666A70" />

                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Button x:Name="CancelApplyButton"
                                    Width="90"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    Content="취소"
                                    Cursor="Hand"
                                    Click="CancelApplyButton_Click" />

                            <Button x:Name="ConfirmApplyButton"
                                    Width="110"
                                    Height="32"
                                    Content="적용 실행"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Click="ConfirmApplyButton_Click" />

                        </StackPanel>
                    </Grid>
                </Border>


                <!-- NORMAL FOOTER -->

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="FooterMessageTextBlock"
                               Grid.Column="0"
                               Margin="0,0,18,0"
                               VerticalAlignment="Center"
                               Text="Preview 단계에서는 Revit Parameter를 수정하지 않습니다."
                               FontSize="11"
                               Foreground="#777B81" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">

                        <Button x:Name="ApplyImportButton"
                                Width="120"
                                Height="34"
                                Margin="0,0,8,0"
                                Content="Apply Import"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="ApplyImportButton_Click" />

                        <Button x:Name="CloseButton"
                                Width="90"
                                Height="34"
                                Content="닫기"
                                Cursor="Hand"
                                Click="CloseButton_Click" />

                    </StackPanel>
                </Grid>

            </StackPanel>
        </Border>

    </Grid>
</Window>