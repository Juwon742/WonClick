<Window x:Class="WonClick.TypeNameParameter.UI.SKManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WonClick - SK Manager"
        Width="640"
        Height="840"
        MinWidth="600"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- Auto Sync                                            -->
        <!-- ===================================================== -->
        <GroupBox Grid.Row="0"
                  Header="SK Auto Sync"
                  Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="AutoStatusText"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="상태 확인 중..."/>
                    <TextBlock Margin="0,4,12,0"
                               Foreground="DimGray"
                               TextWrapping="Wrap"
                               Text="신규 생성, Type/Size/Angle 변경, Pipe/Duct Insulation 변경을 자동 추적합니다."/>
                </StackPanel>

                <Button x:Name="AutoToggleButton"
                        Grid.Column="1"
                        Width="105"
                        Height="34"
                        Content="ON / OFF"
                        Click="AutoToggleButton_Click"/>
            </Grid>
        </GroupBox>

        <!-- ===================================================== -->
        <!-- Current Context                                      -->
        <!-- ===================================================== -->
        <GroupBox Grid.Row="1"
                  Header="Current Context"
                  Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,0,12,4"
                           FontWeight="SemiBold"
                           Text="Current View"/>
                <TextBlock x:Name="CurrentViewText"
                           Grid.Row="0"
                           Grid.Column="1"
                           Margin="0,0,0,4"
                           Text="-"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,0,12,4"
                           FontWeight="SemiBold"
                           Text="Selected"/>
                <TextBlock x:Name="SelectedCountText"
                           Grid.Row="1"
                           Grid.Column="1"
                           Margin="0,0,0,4"
                           Text="0 Elements"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Margin="0,0,12,0"
                           FontWeight="SemiBold"
                           Text="All Candidates"/>
                <TextBlock x:Name="CandidateCountText"
                           Grid.Row="2"
                           Grid.Column="1"
                           Text="-"/>

                <Button x:Name="RefreshButton"
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="2"
                        Width="88"
                        Height="30"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        Content="Refresh"
                        Click="RefreshButton_Click"/>
            </Grid>
        </GroupBox>

        <!-- ===================================================== -->
        <!-- Manual Sync                                          -->
        <!-- ===================================================== -->
        <GroupBox Grid.Row="2"
                  Header="Manual Sync"
                  Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="SyncSelectionButton"
                        Grid.Row="0"
                        Grid.Column="0"
                        Height="38"
                        Content="Selected Elements"
                        Click="SyncSelectionButton_Click"/>

                <Button x:Name="SyncViewButton"
                        Grid.Row="0"
                        Grid.Column="2"
                        Height="38"
                        Content="Current View"
                        Click="SyncViewButton_Click"/>

                <Separator Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Margin="0,10,0,10"/>

                <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="3">
                    <TextBlock Margin="0,0,0,6"
                               FontWeight="SemiBold"
                               Text="Entire Project"/>
                    <TextBlock Margin="0,0,0,8"
                               Foreground="DimGray"
                               TextWrapping="Wrap"
                               Text="프로젝트 전체를 수정하는 작업입니다. 대형 프로젝트에서는 Commit에 상당한 시간이 소요될 수 있으며 실행 전 확인창이 한 번 더 표시됩니다."/>
                    <Button x:Name="SyncAllButton"
                            Height="38"
                            Content="Entire Project Sync..."
                            Click="SyncAllButton_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ===================================================== -->
        <!-- View Fill                                            -->
        <!-- ===================================================== -->
        <GroupBox Grid.Row="3"
                  Header="View Fill"
                  Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="ViewFillStatusText"
                           Grid.Row="0"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"
                           Text="3D View + Section Box 상태를 확인 중입니다."/>

                <DataGrid x:Name="ViewFillGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          MinHeight="145"
                          Margin="0,0,0,8">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Parameter"
                                                Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.ParameterNames, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                                              SelectedItem="{Binding ParameterName, UpdateSourceTrigger=PropertyChanged}"
                                              MinWidth="180"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Value"
                                                Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             MinWidth="180"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="AddRowButton"
                            Grid.Column="0"
                            Width="88"
                            Height="30"
                            Margin="0,0,8,0"
                            Content="Add Row"
                            Click="AddRowButton_Click"/>

                    <Button x:Name="RemoveRowButton"
                            Grid.Column="1"
                            Width="110"
                            Height="30"
                            Content="Remove Selected"
                            Click="RemoveRowButton_Click"/>

                    <Button x:Name="ApplyViewFillButton"
                            Grid.Column="3"
                            Width="130"
                            Height="32"
                            Content="Apply View Fill"
                            Click="ApplyViewFillButton_Click"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- ===================================================== -->
        <!-- Result / Close                                       -->
        <!-- ===================================================== -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="ResultTextBox"
                     Grid.Row="0"
                     Height="90"
                     Margin="0,0,0,10"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="Ready"/>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <TextBlock x:Name="BusyText"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="DimGray"
                           Text=""/>

                <Button Width="90"
                        Height="30"
                        Content="Close"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
